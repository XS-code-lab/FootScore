DATABASE_URL=sqlite:///./footscore-dev.db
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
PROVIDER_DAILY_LIMIT=100
PROVIDER_RESERVE=10
POSTGRES_PASSWORD=change-this-before-running
SYNC_LEAGUES=39:2026
SYNC_INTERVAL_MINUTES=360

# Required to issue JWT access tokens. Generate securely: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
# Optional FCM sender uses GOOGLE_APPLICATION_CREDENTIALS on the worker only.

# Optional: required for WebSocket live updates and outbox publisher
REDIS_URL=redis://localhost:6379/0
