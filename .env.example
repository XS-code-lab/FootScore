DATABASE_URL=sqlite:///./footscore-dev.db
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
PROVIDER_DAILY_LIMIT=100
PROVIDER_RESERVE=10
# Conservative rolling 60-second in-app rate limit (API plan states <= 10/min)
PROVIDER_PER_MINUTE_LIMIT=8
POSTGRES_PASSWORD=change-this-before-running
SYNC_LEAGUES=39:2026
SYNC_INTERVAL_MINUTES=360

# Required to issue JWT access tokens. Generate securely: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
# Optional FCM sender uses GOOGLE_APPLICATION_CREDENTIALS on the worker only.

# Optional: required for WebSocket live updates and outbox publisher
REDIS_URL=redis://localhost:6379/0

# Optional email confirmation and password reset: only SMTPS (implicit TLS).
# Enable REQUIRE_VERIFIED_EMAIL=true after configuring working SMTP.
REQUIRE_VERIFIED_EMAIL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# Security-email delivery requires a distinct Fernet key. Do NOT reuse JWT_SECRET.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_QUEUE_KEY=
